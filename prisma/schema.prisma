generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Team {
  id        Int     @id @default(1)
  name      String
  logoUrl   String?
  homeVenue String?
}

model Game {
  id         Int          @id @default(autoincrement())
  date       DateTime
  opponent   String
  isHome     Boolean
  homeScore  Int?
  awayScore  Int?
  videoUrl   String?
  venue      String?
  goalScorers GoalScorer[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model GoalScorer {
  id         Int    @id @default(autoincrement())
  gameId     Int
  game       Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  playerName String
  side       String
}
